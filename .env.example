# Ortam değişkenleriyle yapılandırma (ayar dosyasını ezer).
# Kalıcı ayar için panelin "Ayarlar" sayfasını kullanmak daha pratiktir;
# bu dosya sunucu/CI dağıtımları ve tek seferlik çalıştırmalar içindir.
#
# Bu dosyayı otomatik okuyan bir mekanizma YOKTUR — değerleri kabuğunuzda
# kendiniz ayarlamanız gerekir:
#   Windows (PowerShell):  $env:ISYONETIM_CURRENCY = "EUR"
#   Windows (cmd):         set ISYONETIM_CURRENCY=EUR
#   macOS / Linux:         export ISYONETIM_CURRENCY=EUR

# Veritabanı dosyasının yolu (varsayılan: data/isyonetim.db)
ISYONETIM_DB_PATH=

# İşletme kimliği — panel başlığında ve pencere adında görünür
ISYONETIM_BUSINESS_NAME=İşletmem
ISYONETIM_CURRENCY=TL
ISYONETIM_OWNER_NAME=

# Arka plan hatırlatıcı
ISYONETIM_REMINDER_LEAD_MINUTES=15
ISYONETIM_DIGEST_AFTER_HOUR=8

# Ağ sunucu modu (run_server.py)
ISYONETIM_SERVER_PORT=8501
